{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "../dist",
        "module": "es2022",
        "target": "es2022",
        "rootDir": "../",
        "noEmitOnError": false,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "baseUrl": "../",
        "paths": {
            "@shared/*": [
                "shared/*"
            ]
        }
    },
    "include": [
        "./**/*.ts",
        "../shared/**/*.ts"
    ],
    "exclude": [
        "client",
        "vite.config.ts",
        "**/*.test.ts"
    ]
}
